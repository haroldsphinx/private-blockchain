#cloud-config
package_update: true
package_upgrade: true

packages:
  - docker.io
  - curl
  - jq
  - git

write_files:
  - path: /opt/zama/env
    permissions: "0644"
    content: |
      NODE_NAME=${node_name}
      NODE_ROLE=${node_role}
      HOST_IP=${host_ip}
      BOOTNODE_IP=${bootnode_ip}
      BOOTNODE_PUBKEY=${bootnode_pubkey}
      BOOTNODE_ENR=${bootnode_enr}
      MONITORING_IP=${monitoring_private_ip}
      NETWORK_ID=12345
      GETH_BOOTNODES=${bootnode_pubkey != "" ? "enode://${bootnode_pubkey}@${bootnode_ip}:30303" : ""}
      LIGHTHOUSE_BOOTNODES=${node_name != "node-1" ? bootnode_enr : ""}

  - path: /opt/zama/telescope.yml
    permissions: "0644"
    content: |
      server:
        log_level: info
      metrics:
        global:
          scrape_interval: 15s
          external_labels:
            node: ${node_name}
          remote_write:
            - url: http://${monitoring_private_ip}:9090/api/v1/write
        wal_directory: /tmp/telescope
        configs:
          - name: ethereum-private-node
            host_filter: false
            scrape_configs:
              - job_name: geth
                metrics_path: /debug/metrics/prometheus
                static_configs:
                  - targets: ['localhost:6060']
              - job_name: lighthouse
                static_configs:
                  - targets: ['localhost:5054', 'localhost:5064']
      logs:
        positions_directory: /tmp/positions
        configs:
          - name: docker
            clients:
              - url: http://${monitoring_private_ip}:3100/loki/api/v1/push
            scrape_configs:
              - job_name: containers
                docker_sd_configs:
                  - host: unix:///var/run/docker.sock
                relabel_configs:
                  - source_labels: ['__meta_docker_container_name']
                    regex: '/(.*)'
                    target_label: 'container'
      integrations:
        node_exporter:
          enabled: true
        cadvisor:
          enabled: true
          docker_only: true

  - path: /opt/zama/bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      [ -f /opt/zama/.done ] && exit 0

      curl -SL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose
      chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

      git clone ${github_repo} /opt/zama/repo
      cd /opt/zama/repo/docker

      cp /opt/zama/telescope.yml telescope.yml
      ln -sf /opt/zama/repo/genesis genesis

      # Use consistent project name for docker-compose volumes
      export COMPOSE_PROJECT_NAME=zama

      docker run --rm -v zama_geth-data:/data -v $(pwd)/genesis/el:/genesis:ro \
        ethereum/client-go:v1.15.2 init --datadir=/data /genesis/genesis.json

      mkdir -p /var/lib/docker/volumes/zama_geth-data/_data/geth
      cp genesis/nodekeys/${node_name}.key /var/lib/docker/volumes/zama_geth-data/_data/geth/nodekey

      if [ "${node_role}" = "validator" ]; then
        # Import each validator key individually
        for keydir in genesis/validator-keys/${node_name}/keys/0x*; do
          pubkey=$(basename "$keydir")
          docker run --rm \
            -v zama_lighthouse-vc-data:/data \
            -v $(pwd)/genesis:/genesis:ro \
            sigp/lighthouse:v6.0.1 \
            lighthouse account validator import \
            --reuse-password \
            --testnet-dir=/genesis/cl --datadir=/data \
            --keystore=/genesis/validator-keys/${node_name}/keys/$pubkey/voting-keystore.json \
            --password-file=/genesis/validator-keys/${node_name}/secrets/$pubkey
        done
        COMPOSE_PROFILES=validator docker compose --env-file /opt/zama/env up -d
      else
        COMPOSE_PROFILES=rpc docker compose --env-file /opt/zama/env up -d
      fi

      touch /opt/zama/.done

  - path: /etc/systemd/system/zama.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Zama ethereum private node
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=true
      ExecStart=/opt/zama/bootstrap.sh
      TimeoutStartSec=1800

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable docker && systemctl start docker
  - mkdir -p /opt/zama /usr/local/lib/docker/cli-plugins
  - systemctl enable zama && /opt/zama/bootstrap.sh
